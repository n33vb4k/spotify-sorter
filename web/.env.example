# Copy to .env.local for local dev, or set these in Vercel → Project → Settings → Environment Variables.

# Optional: your Spotify app's Client ID. With it set, people on your app's user list
# (Spotify dashboard → User Management) can connect in one click; everyone else can still
# bring their own Client ID. Leave empty to make everyone bring their own.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Optional: where the browser loads the ONNX models from. Defaults to /models on this site.
NEXT_PUBLIC_MODEL_BASE=
